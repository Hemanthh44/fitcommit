# ==========================================================
# FitCommit Backend API Environment Variables (.env.example)
# ==========================================================

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Allowed Frontend URL for Production CORS (no trailing slash)
# Development: http://localhost:5173
# Production:  https://fitcommit-frontend.vercel.app (or your deployed frontend domain)
FRONTEND_URL=http://localhost:5173

# JWT Secret for Signing Authentication Tokens (Use a strong random secret in production)
JWT_SECRET=fitcommit_super_secure_jwt_secret_key_2026_production

# ==========================================================
# Database Configuration
# ==========================================================
# PRIMARY: Production Managed PostgreSQL / Supabase Connection URI
# Example: postgresql://postgres.xxxx:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
# When DATABASE_URL is defined, the system connects directly to PostgreSQL with SSL pooling.
DATABASE_URL=

# OPTIONAL: Seed Demo Cohort Data on Startup (true / false)
# In production, keep as false. Set to true only once to populate demo members/gyms.
RUN_SEED=false

# ==========================================================
# Fallback Local PostgreSQL (Used only if DATABASE_URL is empty)
# If both DATABASE_URL and PG_PASSWORD are empty, the backend runs
# with the zero-dependency embedded database for offline development.
# ==========================================================
USE_POSTGRES=false
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=fitcommit
PG_USER=postgres
PG_PASSWORD=
