# ==========================================================
# FitCommit Frontend Environment Variables (.env.example)
# ==========================================================

# Base URL for backend REST API calls (include /api suffix)
# Development: http://localhost:5000/api
# Production:  https://fitcommit-api.onrender.com/api (or your deployed backend domain)
VITE_API_URL=http://localhost:5000/api

# Public URL of the frontend application (encoded into the physical Gym Entrance QR code)
# Development: http://localhost:5173
# Production:  https://fitcommit-frontend.vercel.app (or your deployed frontend domain)
VITE_APP_URL=http://localhost:5173
