# ==========================================================
# FitCommit Full-Stack Environment Variables Reference
# ==========================================================
# Do NOT commit real secrets (.env) to version control.
# Copy appropriate variables to client/.env and server/.env for local dev.

# ----------------------------------------------------------
# Frontend Variables (client/.env)
# ----------------------------------------------------------
# API Base URL consumed by the React app
VITE_API_URL=http://localhost:5000/api

# Public URL of the frontend app (encoded into the entrance QR code)
VITE_APP_URL=http://localhost:5173

# ----------------------------------------------------------
# Backend Variables (server/.env)
# ----------------------------------------------------------
PORT=5000
NODE_ENV=development
JWT_SECRET=fitcommit_super_secure_jwt_secret_key_2026_production
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase connection string (used in production)
DATABASE_URL=postgresql://postgres:password@your-db-host:5432/postgres

# Optional: populate initial demo records
RUN_SEED=false
